<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>SevenZipSharp</AssemblyName>
        <RootNamespace>SevenZipSharp</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
        <CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.367" PrivateAssets="all" />
        <PackageReference Include="SevenZip.Interop" Version="26.6.0-local.4" />
    </ItemGroup>

</Project>
